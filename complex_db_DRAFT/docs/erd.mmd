  users { uuid id PK
    timestamptz access_expires_at "wajib utk guest, maks 7 hari"
    text email UK
    text full_name
    user_role role "admin|warga|guest"
    user_status status
    int unit_id FK
    text password_hash "argon2id/bcrypt"
    uuid created_by FK "wajib admin" }
  units { int id PK
    smallint block_id FK
    text house_number }
  blocks { smallint id PK
    text name "Jati 1..7" }
  sessions { uuid id PK
    uuid user_id FK
    bytea token_hash UK "SHA-256"
    timestamptz expires_at }
  reports { uuid id PK
    uuid reporter_id FK
    report_category category
    report_status status
    report_recipient recipient }
  facility_requests { uuid id PK
    facility_type facility
    request_status status
    tsrange period "EXCLUDE overlap" }
  sigap_alerts { uuid id PK
    sigap_status status
    uuid user_id FK }
  dues_bills { uuid id PK
    int unit_id FK
    date period
    bill_status status }
  notifications { uuid id PK
    notif_category category
    text source_key UK }
  notification_recipients { uuid notification_id PK
    uuid user_id PK
    timestamptz read_at }
  posts { uuid id PK
    uuid author_id FK
    text body }
  audit_logs { bigint id PK
    text action
    jsonb details "append-only" }

  guest_visits { uuid id PK
    uuid reporter_id FK
    uuid guest_user_id FK
    text visitor_name
    text visitor_address "alamat asal tamu"
    int host_unit_id FK "rumah tujuan"
    text host_name "warga tujuan (opsional)"
    timestamptz visit_start
    timestamptz valid_until "visit_start + 24 jam (trigger)"
    visit_status status "aktif|selesai|dibatalkan"
  }
